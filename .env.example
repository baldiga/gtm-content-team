# Copy to review-app/.env.local for local work, and set the same names on Vercel.
# Fill in real values privately. Never commit this file with real values.
# Placeholder names only appear below.

# Review app
REVIEW_URL=http://127.0.0.1:8787
PORT=8787
TEAM_API_KEY=replace-me
# Local server: the review password is ACCESS_KEY.
ACCESS_KEY=replace-me
# Vercel login: store the SHA-256 hex of the review password, not the plaintext.
#   python3 -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass('Review password: ').encode()).hexdigest())"
ACCESS_KEY_SHA256=
SESSION_SECRET=replace-me-with-a-long-random-string
# Optional name of the review password env var on a private machine only.
# REVIEW_APP_PASSWORD=

# Vercel Blob (production store for review state and login rate limits)
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=content-review

# Brand (optional; config/brand.json is the main place for these)
# BRAND_NAME=Your Name
# BRAND_DOMAIN=yourdomain.com
# OWNER_ID=owner
# OWNER_LABEL=את/ה
# TEAM_LABEL=הצוות
TIMEZONE=Asia/Jerusalem
CLOUDINARY_FOLDER=content-review
# WEEK=YYYY-MM-DD

# Cloudinary (optional; needed when sync.py should host images publicly)
# CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Buffer (Publisher and Analyst)
# BUFFER_ACCESS_TOKEN=
